# Server and browser origin
PORT=5000
CLIENT_URL=http://localhost:5173

# Database and authentication
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Upload limits and ImageKit storage
MAX_FILE_SIZE_MB=25
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# Email delivery (Brevo HTTPS API)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email@example.com
BREVO_SENDER_NAME=Chatly AI

# User-facing AI features
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_text_model_name
GEMINI_FALLBACK_MODEL=your_fallback_text_model_name
GEMINI_EMBEDDING_MODEL=your_embedding_model_name
AI_RATE_LIMIT_PER_HOUR=20